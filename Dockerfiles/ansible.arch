# "parent" is the previous image in the chain, supplied by docker-bake.hcl
FROM parent

# Running ansible playbook. The full -Syu up front means the playbook's
# installs never become a partial upgrade.
ARG ANSIBLE_URL ANSIBLE_SHA PLAYBOOK
RUN pacman -Syu --noconfirm && \
    cd /tmp && \
    git clone ${ANSIBLE_URL} ansible && \
    cd /tmp/ansible && \
    git checkout ${ANSIBLE_SHA} && \
    ANSIBLE_HACKS="--extra-vars='ansible_user=root'" ./run targets ${PLAYBOOK} inventories/localhost.yml && \
    pacman -Scc --noconfirm && \
    rm -rf /tmp/* /var/tmp/*

ARG ORG IMAGE BASE_IMAGE CREATED GIT_URL GIT_SHA ANSIBLE_URL ANSIBLE_SHA PLAYBOOK
RUN --mount=type=bind,source=scripts/image-history.sh,target=/tmp/image-history.sh \
    sh /tmp/image-history.sh
